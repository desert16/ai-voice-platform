# ─── SUNUCU 1 (PBX/Santral: 192.168.1.10) ───
# Bu dosya Sunucu 1'e apps/asterisk-manager/.env olarak kaydedilir

NODE_ENV=production

# Asterisk AMI — Sunucu 1 lokal
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=voicecore_ami
AMI_SECRET=ami_secret_2024

# Redis — Sunucu 2'deki Redis'e bağlan
REDIS_HOST=192.168.1.20
REDIS_PORT=6379
REDIS_PASSWORD=voicecore_redis_2024

# PJSIP ve dialplan dosya yolları
PJSIP_DIR=/etc/asterisk/pjsip.d
DIALPLAN_DIR=/etc/asterisk/extensions.d
ASTERISK_CONF_DIR=/etc/asterisk

# Bridge — Sunucu 1 lokal (AudioSocket)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=9092

# Asterisk Manager API portu (lokal — sadece API Sunucusuna açık)
MANAGER_PORT=4001

# Dahili servis token (API Sunucu ile aynı olmalı)
SERVICE_TOKEN=voicecore_internal_service_token_2024
