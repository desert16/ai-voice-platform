# ─── SUNUCU 1 (PBX/Santral: 192.168.1.10) ───
# Bu dosya Sunucu 1'e apps/bridge/.env olarak kaydedilir

NODE_ENV=production

# AudioSocket port (lokal — dışarıya kapalı)
BRIDGE_PORT=9092
BRIDGE_HOST=0.0.0.0

# Redis — Sunucu 2'deki Redis'e bağlan
REDIS_HOST=192.168.1.20
REDIS_PORT=6379
REDIS_PASSWORD=voicecore_redis_2024

# API Sunucu — Sunucu 2'deki Express API
API_SERVER_URL=http://192.168.1.20:3000

# Gemini AI
GEMINI_API_KEY=AIza_BURAYA_GEMINI_API_KEY

# Fallback system prompt
DEFAULT_SYSTEM_PROMPT=Sen VoiceCore AI'in sesli asistanısın. Kısa, doğal ve nazik cümlelerle konuş. Her zaman Türkçe konuş.
