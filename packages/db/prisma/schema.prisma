// This is your Prisma schema file
// Multi-Tenant AI Voice Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANT (Müşteri Firması)
// ============================================================
model Tenant {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique  // URL-safe isim: "acme-ltd"
  email       String        @unique  // Ana iletişim e-postası
  plan        Plan          @default(STARTER)
  status      TenantStatus  @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users         User[]
  sipTrunks     SipTrunk[]
  agents        Agent[]
  calls         Call[]
  customerApis  CustomerApi[]
  apiKeys       ApiKey[]

  @@index([slug])
}

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  PENDING     // Ödeme bekleniyor
  ACTIVE      // Aktif
  SUSPENDED   // Askıya alındı
  CANCELLED   // İptal edildi
}

// ============================================================
// USER (Kullanıcı - Tenant başına)
// ============================================================
model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         UserRole  @default(MEMBER)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ============================================================
// SIP TRUNK (Müşteri SIP Hattı)
// ============================================================
model SipTrunk {
  id            String      @id @default(cuid())
  tenantId      String
  label         String      // "Ana Hat", "Destek Hattı" vb.
  sipUsername   String      // SIP kullanıcı adı
  sipPassword   String      // Şifreli tutulacak
  sipHost       String      // sip.provider.com
  sipPort       Int         @default(5060)
  phoneNumber   String      // +905XXXXXXXXX
  status        TrunkStatus @default(INACTIVE)
  lastRegisteredAt DateTime?
  configFile    String?     // /etc/asterisk/pjsip.d/tenant_XXXX.conf
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calls  Call[]

  @@index([tenantId])
  @@index([phoneNumber])
}

enum TrunkStatus {
  INACTIVE      // Kayıt yok
  REGISTERING   // Kayıt deneniyor
  ACTIVE        // Kayıtlı ve hazır
  FAILED        // Kayıt başarısız
}

// ============================================================
// AGENT (AI Sesli Ajan - Tenant başına, birden fazla olabilir)
// ============================================================
model Agent {
  id               String      @id @default(cuid())
  tenantId         String
  name             String
  systemPrompt     String      @db.Text
  voiceModel       String      @default("gemini-3.1-flash-live-preview")
  language         String      @default("tr-TR")
  welcomeMessage   String?     @db.Text
  fallbackMessage  String?     @db.Text  // Anlayamadığında
  maxCallDuration  Int         @default(300)  // saniye
  isDefault        Boolean     @default(false)
  status           AgentStatus @default(DRAFT)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions AgentVersion[]
  calls    Call[]

  @@index([tenantId])
}

enum AgentStatus {
  DRAFT
  ACTIVE
  PAUSED
}

// ============================================================
// AGENT VERSION (Prompt geçmişi / sürüm kontrolü)
// ============================================================
model AgentVersion {
  id           String   @id @default(cuid())
  agentId      String
  systemPrompt String   @db.Text
  changeNote   String?
  createdBy    String?  // userId veya "ai-wizard"
  createdAt    DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

// ============================================================
// CUSTOMER API (Müşteri Webhook / Entegrasyon Tanımı)
// ============================================================
model CustomerApi {
  id              String  @id @default(cuid())
  tenantId        String
  name            String        // "Sipariş Sorgula", "Randevu Kontrol"
  description     String?       // Ajan bu tool'u ne zaman kullanmalı
  endpoint        String        // https://api.musteri.com/orders
  method          HttpMethod    @default(GET)
  headers         Json          @default("{}")
  bodyTemplate    Json?         // Request body şablonu (değişkenler {orderNo} gibi)
  responseMapping Json?         // Hangi alanı sese nasıl çevirecek
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

// ============================================================
// CALL (Çağrı Kaydı)
// ============================================================
model Call {
  id              String     @id @default(cuid())
  tenantId        String
  agentId         String?
  sipTrunkId      String?
  asteriskUuid    String     @unique  // AudioSocket UUID (hex)
  callerNumber    String?
  calledNumber    String?
  direction       CallDirection @default(INBOUND)
  status          CallStatus @default(ACTIVE)
  startedAt       DateTime   @default(now())
  endedAt         DateTime?
  duration        Int?       // saniye
  recordingPath   String?    // /recordings/tenantId/callId.wav
  recordingUrl    String?    // CDN veya signed URL
  createdAt       DateTime   @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  agent       Agent?       @relation(fields: [agentId], references: [id])
  sipTrunk    SipTrunk?    @relation(fields: [sipTrunkId], references: [id])
  transcripts Transcript[]

  @@index([tenantId])
  @@index([asteriskUuid])
  @@index([tenantId, startedAt])
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  ACTIVE
  COMPLETED
  FAILED
  ABANDONED
}

// ============================================================
// TRANSCRIPT (Konuşma Metni)
// ============================================================
model Transcript {
  id        String          @id @default(cuid())
  callId    String
  speaker   TranscriptSpeaker
  text      String          @db.Text
  timestamp DateTime        @default(now())
  durationMs Int?           // Bu satırın kaç ms'lik sese karşılık geldiği

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([callId, timestamp])
}

enum TranscriptSpeaker {
  USER    // Arayan kişi
  AGENT   // AI ajan
  SYSTEM  // Sistem mesajı
}

// ============================================================
// API KEY (Müşteri Public API erişimi)
// ============================================================
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String    // "Entegrasyon #1", "Test Key"
  keyHash     String    @unique  // SHA-256 hash
  keyPrefix   String    // İlk 8 karakter (gösterim için): "vc_abc123"
  permissions Json      @default("[\"calls:read\",\"transcripts:read\"]")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyHash])
}
